# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings > API in the Supabase dashboard).
#
# If these are left unset, the app runs in local-only mode: no login screen,
# no cross-device sync, data stays in this browser's localStorage.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
