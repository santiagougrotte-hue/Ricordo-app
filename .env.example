# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings > API in the Supabase dashboard).
#
# If these are left unset, the app runs in local-only mode: no login screen,
# no cross-device sync, data stays in this browser's localStorage.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — nunca se expone al frontend. Se usa en las rutas /api/ia/* de Vercel.
# Sin esta clave las funciones de IA (Fase 7 en adelante) devuelven error, pero el resto
# de la app sigue funcionando igual (carga manual).
ANTHROPIC_API_KEY=

# Solo si la clave de arriba es del tipo `sk-ant-usr-…` (no pertenece a un workspace): el ID del
# workspace de console.anthropic.com a usar (formato `wrkspc_…`). No es secreto.
ANTHROPIC_WORKSPACE_ID=

# --- Export semanal a Google Sheets (/api/export/import-app, lo llama el Apps Script de la planilla) ---
# Server-only. Supabase → Project Settings → API keys → Secret key (`sb_secret_…`) o service_role legacy
# (saltean RLS: nunca NEXT_PUBLIC_).
SUPABASE_SERVICE_ROLE_KEY=
# Texto largo al azar (20+ caracteres). El mismo valor va en las Propiedades del script de la planilla.
EXPORT_TOKEN=
