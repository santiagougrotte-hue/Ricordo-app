# ── Netlify (Site configuration → Environment variables) ──
# La base (Netlify Database) y los archivos (Netlify Blobs) se crean solos: no hay que configurar nada.

# Panel (/admin): tu email y una contraseña larga. Para cambiarla, editá la variable y redeployá.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Clave aleatoria para firmar la sesión (por ejemplo: openssl rand -hex 32)
SESSION_SECRET=

# Cloudflare Turnstile (captcha del checkout)
# Para probar: sitio 1x00000000000000000000AA / secreto 1x0000000000000000000000000000000AA
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Opcionales: aviso de pedido nuevo
# RESEND_API_KEY=
# NOTIFY_FROM=Ricordo <pedidos@tu-dominio.com>
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Solo desarrollo local: VITE_DEMO=1 usa datos de ejemplo sin servidor (npm run dev ya lo pone).
